INTERLIS 2.3;
MODEL Lab_Standorte_Edit (de) AT "https://example.org/netl-test" VERSION "2026-01-01" =
  DOMAIN
    Coord = COORD 2400000.000 .. 2900000.000, 1000000.000 .. 1400000.000;
  TOPIC Standorte =
    CLASS Organisation =
      AName : MANDATORY TEXT*80;
    END Organisation;
    CLASS Standort =
      Kennung : MANDATORY TEXT*40;
      AName : MANDATORY TEXT*80;
      Geometrie : MANDATORY Coord;
      UNIQUE Kennung;
    END Standort;
    ASSOCIATION Standort_Organisation =
      Organisation -- {1} Organisation;
      Standort -- {0..*} Standort;
    END Standort_Organisation;
  END Standorte;
END Lab_Standorte_Edit.
